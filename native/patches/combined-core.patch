+static void report_timestamp_mode(kernel_timestamp_session_t *session, int mode) {
+    if (session->timestamp_mode_reported != mode) {
+        logger_log(session->raop_ntp->logger, LOGGER_INFO,
+                   "clock receive mode: socket=%d source=%s", session->sock_fd,
+                   mode == 1 ? "kernel-timestamp" : "userspace-clock-fallback");
+        session->timestamp_mode_reported = mode;
+    }
+}
