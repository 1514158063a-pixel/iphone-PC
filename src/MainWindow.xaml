<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone-PC" Width="1100" Height="720" MinWidth="900" MinHeight="620"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="13" Foreground="#202A36"
        Language="zh-CN" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202A36" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#657183" />
        <SolidColorBrush x:Key="LineBrush" Color="#DFE4EB" />

        <Style x:Key="KeyboardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-3" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2" CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#D5DDE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SelectionBrush" Value="#B9DAF7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Text}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}" Visibility="Hidden" IsHitTestVisible="False" />
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Margin="-6,-2,-6,-2" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,-2,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6FA" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#EDF5FD" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EEF1F5" />
                    <Setter Property="Foreground" Value="#8A95A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#C8D0DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F5FB" />
                    <Setter Property="BorderBrush" Value="#8AA6C3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0EBF7" />
                    <Setter Property="BorderBrush" Value="#5D83AA" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F3F5F7" />
                    <Setter Property="Foreground" Value="#9AA3AF" />
                    <Setter Property="BorderBrush" Value="#E0E4E9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FloatingButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#293646" />
            <Setter Property="Foreground" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="#465669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384B61" />
                    <Setter Property="BorderBrush" Value="#6D89A9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#405B78" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#006CBE" />
                    <Setter Property="BorderBrush" Value="#006CBE" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E" />
                    <Setter Property="BorderBrush" Value="#005A9E" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#004F8C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5EAF0" />
                    <Setter Property="BorderBrush" Value="#E5EAF0" />
                    <Setter Property="Foreground" Value="#9AA3AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FpsSegmentStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF1F9" />
                    <Setter Property="Foreground" Value="#205888" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#006CBE" />
                    <Setter Property="BorderBrush" Value="#006CBE" />
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#004F8C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F0F2F5" />
                    <Setter Property="Foreground" Value="#9AA3AF" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DFEDFB" />
                    <Setter Property="Foreground" Value="#005A9E" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EDF4FC" />
                    <Setter Property="Foreground" Value="#005A9E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA3AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#C8D0DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsTabStop="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,38,0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="None"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,3,0,0" Padding="4" Background="White"
                                            BorderBrush="#B9C5D3" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFD" />
                    <Setter Property="BorderBrush" Value="#8AA6C3" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F0F2F5" />
                    <Setter Property="Foreground" Value="#9AA3AF" />
                    <Setter Property="BorderBrush" Value="#E0E4E9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="屏幕镜像" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="在工作台中查看 iPhone 画面" Margin="0,5,0,0" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,8,0,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8C99AA" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" Text="等待连接" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,20,0,14" Background="Black" BorderBrush="#263446"
                    BorderThickness="1" CornerRadius="6" Padding="1">
                <Grid>
                    <Grid x:Name="VideoSlot" Background="Black" ClipToBounds="True" />
                    <Grid x:Name="WaitPanel" Background="#101722" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" MaxWidth="440">
                            <Grid Width="116" Height="84" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Rectangle Width="10" Height="12" Fill="#5E7189"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                <Rectangle Width="46" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#71839A"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                <Border Height="66" VerticalAlignment="Top" BorderBrush="#71839A"
                                        BorderThickness="2" CornerRadius="4" Background="#162233">
                                    <Path Data="M 36,43 L 56,23 L 76,43 Z" Fill="#87B9EB"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="WaitTitle" Text="等待 iPhone 连接" FontSize="22" Foreground="#F0F4F9"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="WaitInstruction" Margin="0,14,0,0" Foreground="#BFCCDC" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="23">
                                <Run Text="在 iPhone 打开控制中心" /><LineBreak />
                                <Run Text="选择「屏幕镜像」→「iPhone-PC」" />
                            </TextBlock>
                            <TextBlock x:Name="WaitNetworkText" Text="手机和电脑需连接同一局域网" FontSize="12" Foreground="#8294AB"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="保持原始比例" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ScaleButton" Content="画面缩放 100%  ▾" Margin="0,0,8,0" MinWidth="142"
                            ToolTip="只缩放画面，保持窗口大小。" />
                    <Button x:Name="DetachButton" Content="独立窗口" MinWidth="104" Margin="0,0,8,0"
                            ToolTip="将画面移到独立窗口；再次点击可嵌回工作台。" />
                    <Button x:Name="FullscreenButton" Content="全屏" MinWidth="76"
                            ToolTip="在独立窗口中全屏显示画面。" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Margin="0,18,0,0" Padding="0,14,0,0">
                <TextBlock x:Name="ActualText" Text="实际接收：等待连接" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#F6F8FA" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="20,22,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly" Margin="0,0,0,18">
                    <StackPanel Margin="0,0,0,3">
                        <TextBlock Text="画面设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" />

                        <Label Content="分辨率请求" Target="{Binding ElementName=ResolutionCombo}"
                               Padding="0" Margin="0,0,0,8" Foreground="#435166" />
                        <ComboBox x:Name="ResolutionCombo" SelectedIndex="3" Margin="0,0,0,18"
                                  AutomationProperties.Name="分辨率请求" IsEditable="False">
                            <ComboBoxItem Content="720p" Tag="1280x720" />
                            <ComboBoxItem Content="1080p" Tag="1920x1080" />
                            <ComboBoxItem Content="1440p" Tag="2560x1440" />
                            <ComboBoxItem Content="4K" Tag="3840x2160" />
                        </ComboBox>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="帧率上限" Foreground="#435166" />
                            <TextBlock Text="fps" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Background="White" BorderBrush="#CDD5DF" BorderThickness="1"
                                CornerRadius="6" Padding="3" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="Fps24" GroupName="Fps" Content="24"
                                             Style="{StaticResource FpsSegmentStyle}" AutomationProperties.Name="24 fps 上限" />
                                <RadioButton x:Name="Fps30" Grid.Column="1" GroupName="Fps" Content="30" Margin="3,0"
                                             Style="{StaticResource FpsSegmentStyle}" AutomationProperties.Name="30 fps 上限" />
                                <RadioButton x:Name="Fps60" Grid.Column="2" GroupName="Fps" Content="60" IsChecked="True"
                                             Style="{StaticResource FpsSegmentStyle}" AutomationProperties.Name="60 fps 上限" />
                            </Grid>
                        </Border>

                        <TextBlock Text="实际输出由手机及片源决定。" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="更改设置会重启接收端，需要在 iPhone 上重新连接。" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16" />
                        <Button x:Name="ApplyButton" Content="应用画质" MinHeight="38"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock x:Name="FeedbackText" Text="选择画质后点击应用。" MinHeight="36" Margin="0,8,0,0"
                                   FontSize="12" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="168" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="接收名称" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="ReceiverNameInput" Grid.Column="1" Text="iPhone-PC"
                                     AutomationProperties.Name="接收名称" ToolTip="点击修改；支持中文和空格。" />
                            <TextBlock Grid.Row="1" Text="连接密码" FontSize="12" Margin="0,9,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="PasswordInput" Grid.Row="1" Grid.Column="1" Text="6817" Margin="0,7,0,0"
                                     MaxLength="32" InputMethod.IsInputMethodEnabled="False"
                                     AutomationProperties.Name="连接密码" ToolTip="点击修改；4–32 位英文字母或数字。" />
                        </Grid>
                        <TextBlock x:Name="ConnectionFeedbackText" Visibility="Collapsed" />
                        <Button x:Name="RestartButton" Content="保存并重启接收" Margin="0,15,0,0"
                                ToolTip="保存接收名称和连接密码，并重新启动接收端。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F8F9FB" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentModeText" Text="工作台内显示" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EngineText" Grid.Column="1" Text="正在启动接收端" FontSize="11" Margin="16,0,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
